{
  "manifest": 1,
  "id": "fugue/edit-image",
  "version": "1.0.0",
  "name": "Edit Image",
  "description": "Changes or combines images by an instruction, on an image model that edits.",
  "category": "Generate",
  "keywords": ["edit", "instruct", "reference", "combine", "kontext"],
  "runtime": {"kind": "builtin"},
  "capabilities": ["image.edit"],
  "inputs": [
    {"name": "instruction", "type": "text", "label": "Instruction", "widget": "multiline"},
    {"name": "images", "type": "image", "label": "Images", "list": true, "min_items": 1,
     "description": "One or more references, up to the model's limit (four when it reports none). The result takes the first one's shape, near a megapixel."},
    {"name": "model", "type": "fugue/image-model", "label": "Model", "optional": true,
     "description": "Unset: any ready model that edits."},
    {"name": "steps", "type": "number", "label": "Steps", "optional": true, "integer": true, "min": 1, "max": 200,
     "advanced": true, "description": "Unset: the model's default."},
    {"name": "seed", "type": "number", "label": "Seed", "default": 0, "integer": true, "min": 0,
     "max": 9007199254740991, "widget": "seed"}
  ],
  "outputs": [
    {"name": "image", "type": "image", "label": "Image"},
    {"name": "seed", "type": "number", "label": "Seed used"},
    {"name": "width", "type": "number", "label": "Width used"},
    {"name": "height", "type": "number", "label": "Height used"},
    {"name": "model", "type": "fugue/image-model", "label": "Model used"}
  ]
}
