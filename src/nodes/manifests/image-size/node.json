{
  "manifest": 1,
  "id": "fugue/image-size",
  "version": "1.0.0",
  "name": "Image Size",
  "description": "A width and a height from an aspect ratio and a number of megapixels, each a multiple of 64 (the steps image models work in), for Generate Image, Edit Image or Resize.",
  "category": "Basic",
  "keywords": ["resolution", "aspect", "ratio", "megapixel", "width", "height", "dimensions"],
  "runtime": {"kind": "builtin"},
  "inputs": [
    {"name": "aspect", "type": "text", "label": "Aspect", "default": "1:1",
     "choices": ["1:1", "16:9", "9:16", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "6:5", "5:6", "21:9", "9:21"]},
    {"name": "megapixels", "type": "number", "label": "Megapixels", "default": 1, "min": 0.1, "max": 16, "step": 0.05},
    {"name": "multiple", "type": "number", "label": "Multiple of", "default": 64, "min": 1, "max": 256, "integer": true,
     "advanced": true, "description": "Each side is a multiple of this."}
  ],
  "outputs": [
    {"name": "width", "type": "number", "label": "Width"},
    {"name": "height", "type": "number", "label": "Height"}
  ]
}
