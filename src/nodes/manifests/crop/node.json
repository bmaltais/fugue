{
  "manifest": 1,
  "id": "fugue/crop",
  "version": "1.0.0",
  "name": "Crop",
  "description": "Cut a rectangle out of an image. A rectangle that runs past the edge stops at the edge.",
  "category": "Image/Transform",
  "keywords": ["trim", "cut"],
  "runtime": {"kind": "builtin"},
  "inputs": [
    {"name": "image", "type": "image", "label": "Image"},
    {"name": "x", "type": "number", "label": "X", "default": 0, "min": 0, "max": 16384, "step": 1, "integer": true},
    {"name": "y", "type": "number", "label": "Y", "default": 0, "min": 0, "max": 16384, "step": 1, "integer": true},
    {"name": "width", "type": "number", "label": "Width", "default": 512, "min": 1, "max": 16384, "step": 1, "integer": true},
    {"name": "height", "type": "number", "label": "Height", "default": 512, "min": 1, "max": 16384, "step": 1, "integer": true}
  ],
  "outputs": [
    {"name": "image", "type": "image", "label": "Image"}
  ]
}
