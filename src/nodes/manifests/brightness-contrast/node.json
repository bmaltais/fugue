{
  "manifest": 1,
  "id": "fugue/brightness-contrast",
  "version": "1.0.0",
  "name": "Brightness and Contrast",
  "description": "Lighten or darken an image (brightness, added) and spread or squeeze its tones around mid gray (contrast, multiplied). Alpha is left alone.",
  "category": "Image/Adjust",
  "keywords": ["light", "exposure", "tone"],
  "runtime": {"kind": "builtin"},
  "inputs": [
    {"name": "image", "type": "image", "label": "Image"},
    {"name": "brightness", "type": "number", "label": "Brightness", "default": 0, "min": -1, "max": 1, "step": 0.01, "widget": "slider"},
    {"name": "contrast", "type": "number", "label": "Contrast", "default": 1, "min": 0, "max": 4, "step": 0.01, "widget": "slider"}
  ],
  "outputs": [
    {"name": "image", "type": "image", "label": "Image"}
  ]
}
