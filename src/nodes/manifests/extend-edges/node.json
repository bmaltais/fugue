{
  "manifest": 1,
  "id": "fugue/extend-edges",
  "version": "1.0.0",
  "name": "Extend Edges",
  "description": "Fill what lies under a mask from the nearest picture, stretched outward and blurred, so an outpaint or a removal starts from the colors beside it and not from gray. Better than Fill Masked's blur for a hole open on one side, where a blur across it pulls the far side in. Where the mask is 0 the picture is unchanged.",
  "category": "Image/Mask",
  "keywords": [
    "outpaint",
    "pre-fill",
    "stretch",
    "edge",
    "extend",
    "expand"
  ],
  "runtime": {
    "kind": "builtin"
  },
  "inputs": [
    {
      "name": "image",
      "type": "image",
      "label": "Image"
    },
    {
      "name": "mask",
      "type": "image",
      "role": "mask",
      "label": "Mask"
    },
    {
      "name": "mode",
      "type": "text",
      "label": "Mode",
      "default": "edge-blur",
      "choices": [
        "edge",
        "edge-blur"
      ]
    },
    {
      "name": "blur",
      "type": "number",
      "label": "Blur",
      "default": 24,
      "min": 0,
      "max": 512,
      "step": 1,
      "integer": true,
      "advanced": true
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "image",
      "label": "Image"
    }
  ]
}
