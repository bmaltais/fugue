{
  "manifest": 1,
  "id": "fugue/sharpen",
  "version": "1.0.0",
  "name": "Sharpen",
  "description": "Sharpen with a Gaussian kernel, ComfyUI's Sharpen Image. Alpha is left alone.",
  "category": "Image/Adjust",
  "keywords": [
    "unsharp",
    "crisp",
    "detail"
  ],
  "runtime": {
    "kind": "builtin"
  },
  "inputs": [
    {
      "name": "image",
      "type": "image",
      "label": "Image"
    },
    {
      "name": "radius",
      "type": "number",
      "label": "Radius",
      "default": 1,
      "min": 1,
      "max": 31,
      "step": 1,
      "integer": true,
      "advanced": true
    },
    {
      "name": "sigma",
      "type": "number",
      "label": "Sigma",
      "default": 1.0,
      "min": 0.1,
      "max": 10,
      "step": 0.01,
      "advanced": true
    },
    {
      "name": "amount",
      "type": "number",
      "label": "Amount",
      "default": 1.0,
      "min": 0,
      "max": 5,
      "step": 0.01,
      "advanced": true
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "image",
      "label": "Image"
    }
  ]
}
