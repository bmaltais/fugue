{
  "manifest": 1,
  "id": "fugue",
  "version": "1.0.0",
  "name": "Fugue",
  "license": "MIT",
  "source": "https://github.com/bmaltais/fugue",
  "description": "The nodes that ship with Fugue.",
  "nodes": [
    "apply-lora",
    "blend",
    "blur",
    "brightness-contrast",
    "canvas-region",
    "canvas-write",
    "color-match",
    "combine-masks",
    "compare-images",
    "composite-masked",
    "crop",
    "crop-to-mask",
    "describe-image",
    "edit-image",
    "empty-latent",
    "empty-video-latent",
    "enhance-prompt",
    "feather-mask",
    "fill-masked",
    "flip",
    "generate-image",
    "generate-song",
    "generate-video",
    "grow-mask",
    "image-size",
    "image-to-mask",
    "inpaint-crop-stitch",
    "invert",
    "invert-mask",
    "load-audio",
    "load-image",
    "load-models",
    "load-upscale-model",
    "load-video",
    "number",
    "number-math",
    "overlay-mask",
    "pad",
    "paint",
    "paint-mask",
    "preview",
    "remix-song",
    "repaint-song",
    "resize",
    "resize-megapixels",
    "rotate",
    "sampler",
    "save-audio",
    "save-image",
    "save-video",
    "sharpen",
    "solid-mask",
    "stitch",
    "text",
    "text-concat",
    "text-encode",
    "text-generate",
    "threshold-mask",
    "upscale-image",
    "upscale-video",
    "upscale-video-with-model",
    "upscale-with-model",
    "vae-decode",
    "vae-decode-video",
    "vae-encode",
    "vae-encode-video"
  ],
  "types": [
    {
      "id": "fugue/image-model",
      "version": 1,
      "kind": "resource",
      "name": "Image model"
    },
    {
      "id": "fugue/text-model",
      "version": 1,
      "kind": "resource",
      "name": "Text model"
    },
    {
      "id": "fugue/video-model",
      "version": 1,
      "kind": "resource",
      "name": "Video model"
    },
    {
      "id": "fugue/music-model",
      "version": 1,
      "kind": "resource",
      "name": "Music model"
    },
    {
      "id": "fugue/music-adapter",
      "version": 1,
      "kind": "resource",
      "name": "Music adapter"
    },
    {
      "id": "fugue/model",
      "version": 1,
      "kind": "resource",
      "name": "Model",
      "folders": [
        "checkpoints"
      ],
      "files": "checkpoint"
    },
    {
      "id": "fugue/diffusion-model",
      "version": 1,
      "kind": "resource",
      "name": "Diffusion model",
      "folders": [
        "diffusion-model",
        "diffusion_models",
        "unet"
      ],
      "files": "diffusion-model"
    },
    {
      "id": "fugue/text-encoder",
      "version": 1,
      "kind": "resource",
      "name": "Text encoder",
      "folders": [
        "text-encoder",
        "text_encoders",
        "clip"
      ],
      "files": "text-encoder"
    },
    {
      "id": "fugue/vae",
      "version": 1,
      "kind": "resource",
      "name": "VAE",
      "folders": [
        "vae"
      ],
      "files": "vae"
    },
    {
      "id": "fugue/lora",
      "version": 1,
      "kind": "resource",
      "name": "LoRA",
      "folders": [
        "lora",
        "loras"
      ],
      "files": "lora"
    },
    {
      "id": "fugue/upscale-model",
      "version": 1,
      "kind": "resource",
      "name": "Upscale model",
      "extensions": [
        ".safetensors",
        ".pth",
        ".gguf"
      ],
      "folders": [
        "upscale_models",
        "upscaler",
        "ESRGAN"
      ]
    },
    {
      "id": "fugue/latent",
      "version": 1,
      "kind": "data",
      "name": "Latent"
    },
    {
      "id": "fugue/conditioning",
      "version": 1,
      "kind": "data",
      "name": "Conditioning"
    },
    {
      "id": "fugue/stitch",
      "version": 1,
      "kind": "data",
      "name": "Stitch"
    },
    {
      "id": "fugue/canvas",
      "version": 1,
      "kind": "data",
      "name": "Canvas"
    }
  ]
}
