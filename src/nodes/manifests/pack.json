{
  "manifest": 1,
  "id": "fugue",
  "version": "1.0.0",
  "name": "Fugue",
  "license": "MIT",
  "source": "https://github.com/bmaltais/fugue",
  "description": "The nodes that ship with Fugue.",
  "nodes": [
    "apply-lora",
    "blend",
    "brightness-contrast",
    "crop",
    "edit-image",
    "empty-latent",
    "generate-image",
    "image-size",
    "load-image",
    "load-models",
    "number",
    "preview",
    "resize",
    "sampler",
    "save-image",
    "text",
    "text-concat",
    "text-encode",
    "vae-decode",
    "vae-encode"
  ],
  "types": [
    {
      "id": "fugue/image-model",
      "version": 1,
      "kind": "resource",
      "name": "Image model"
    },
    {
      "id": "fugue/model",
      "version": 1,
      "kind": "resource",
      "name": "Model",
      "folders": [
        "checkpoints"
      ],
      "files": "checkpoint"
    },
    {
      "id": "fugue/diffusion-model",
      "version": 1,
      "kind": "resource",
      "name": "Diffusion model",
      "folders": [
        "diffusion-model",
        "diffusion_models",
        "unet"
      ],
      "files": "diffusion-model"
    },
    {
      "id": "fugue/text-encoder",
      "version": 1,
      "kind": "resource",
      "name": "Text encoder",
      "folders": [
        "text-encoder",
        "text_encoders",
        "clip"
      ],
      "files": "text-encoder"
    },
    {
      "id": "fugue/vae",
      "version": 1,
      "kind": "resource",
      "name": "VAE",
      "folders": [
        "vae"
      ],
      "files": "vae"
    },
    {
      "id": "fugue/lora",
      "version": 1,
      "kind": "resource",
      "name": "LoRA",
      "folders": [
        "lora",
        "loras"
      ],
      "files": "lora"
    },
    {
      "id": "fugue/latent",
      "version": 1,
      "kind": "data",
      "name": "Latent"
    },
    {
      "id": "fugue/conditioning",
      "version": 1,
      "kind": "data",
      "name": "Conditioning"
    }
  ]
}
