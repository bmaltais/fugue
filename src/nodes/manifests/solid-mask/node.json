{
  "manifest": 1,
  "id": "fugue/solid-mask",
  "version": "1.0.1",
  "name": "Solid Mask",
  "description": "A mask of one value, width by height.",
  "category": "Image/Mask",
  "keywords": [
    "constant",
    "fill",
    "empty"
  ],
  "runtime": {
    "kind": "builtin"
  },
  "inputs": [
    {
      "name": "value",
      "type": "number",
      "label": "Value",
      "default": 1.0,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "widget": "slider"
    },
    {
      "name": "width",
      "type": "number",
      "label": "Width",
      "default": 512,
      "min": 1,
      "max": 16384,
      "step": 1,
      "integer": true
    },
    {
      "name": "height",
      "type": "number",
      "label": "Height",
      "default": 512,
      "min": 1,
      "max": 16384,
      "step": 1,
      "integer": true
    }
  ],
  "outputs": [
    {
      "name": "mask",
      "type": "image",
      "role": "mask",
      "label": "Mask"
    }
  ]
}
