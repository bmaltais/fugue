# Maintainer: Bernard Maltais <bmaltais@users.noreply.github.com>
#
# CI (.github/workflows/test.yml) reads this file for the dependency lists, so
# a new dependency goes here and nowhere else. Once a recipe lives in
# omarchy-pkgs, move it there and point the workflow back at it.
#
# Two packages: fugue, with the helper built for Vulkan (any GPU), and
# fugue-helper-cuda, the faster helper for NVIDIA cards (spec 8.10). The helper's
# stable-diffusion.cpp sources are the pin of helper/CMakeLists.txt: move both
# together.

# Environment (all optional; CI sets them, see .github/workflows/package.yml):
#   FUGUE_SKIP_CUDA=1  build only `fugue`: no CUDA toolkit, no fugue-helper-cuda
#   FUGUE_SRC=<path>   take the fugue sources from this checkout instead of GitHub
#   FUGUE_REF=<ref>    what to build: branch=main, tag=v0.1.0 or commit=<sha> (default: GitHub's HEAD)

pkgbase=fugue
if [[ -n ${FUGUE_SKIP_CUDA:-} ]]; then pkgname=('fugue'); else pkgname=('fugue' 'fugue-helper-cuda'); fi
pkgver=0.1.0
pkgrel=1
pkgdesc='Node-based workflows for local AI'
arch=('x86_64' 'aarch64')
url='https://github.com/bmaltais/fugue'
license=('MIT')
options=('!debug')
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'libarchive'
  'libvips'
  'qt6-base'
  'qt6-declarative'
  'qt6-imageformats' # the WebP reader: the templates' preview.webp pictures
  'qt6-multimedia' # the QtMultimedia QML module: the player on a video or song node (#116)
  'qt6-multimedia-ffmpeg' # its backend, named so pacman does not ask gstreamer or ffmpeg; ffmpeg is already a dependency
  'qt6-wayland'
  'vulkan-icd-loader'
)
makedepends=(
  'clang'
  'cmake'
  'gcc'
  'git'
  'make'
  'pkgconf'
  'qt6-shadertools'
  'shaderc'
  'spirv-headers'
  'vulkan-headers'
)
[[ -n ${FUGUE_SKIP_CUDA:-} ]] || makedepends+=('cuda')
checkdepends=(
  'jq'
  'noto-fonts'
)
# Fugue's fork, tag fugue-2026-11-24: upstream 3b12781f plus Fugue's engine commits.
_sdcpp=0bcd3abf4af88d54ed74f30ab3230d70272c56bc
_ggml=eeda9ec48fc84a3df0bb9dcc19ae9053075a2539
_cutlass=ad7b2f5e84fcfa124cb02b91d5bd26d238c0459e
_src=${FUGUE_SRC:+file://$FUGUE_SRC}
_src=${_src:-$url.git}
source=("$pkgbase::git+$_src${FUGUE_REF:+#$FUGUE_REF}"
        "fugue-workflows::git+https://github.com/bmaltais/fugue-workflows.git"
        "sdcpp-$_sdcpp.tar.gz::https://github.com/bmaltais/stable-diffusion.cpp/archive/$_sdcpp.tar.gz"
        "ggml-$_ggml.tar.gz::https://github.com/leejet/ggml/archive/$_ggml.tar.gz"
        "cutlass-$_cutlass.tar.gz::https://github.com/NVIDIA/cutlass/archive/$_cutlass.tar.gz")
sha256sums=('SKIP'
            'SKIP'
            '94304e04cd1c5fdf8a8d2ab1069b8fbd85f83e63fa1ab648a526381dac663fc8'
            '8bd7adc7eb1366d31670467951d21eb1a5f55e8f6d89b9b91909ffb0246ac5d2'
            '36429479df2ab1cd1c7981c2d34e786106326ccfefc8846f902f76151a65e112')

pkgver() {
  cd "$srcdir/$pkgbase"
  # From the newest v* tag: v0.1.0 is 0.1.0, v0.1.0-test1 is 0.1.0_test1, and commits after it add .rN.gHASH.
  local described
  if described=$(git describe --long --tags --match 'v*' 2>/dev/null); then
    sed -E 's/^v//; s/-0-g[0-9a-f]+$//; s/-([0-9]+)-g([0-9a-f]+)$/.r\1.g\2/; s/-/_/g' <<<"$described"
  else
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

prepare() {
  # The bundled templates, at the commit the fugue checkout pins (its `templates` submodule).
  cd "$srcdir/$pkgbase"
  git submodule init templates
  git config submodule.templates.url "$srcdir/fugue-workflows"
  git -c protocol.file.allow=always submodule update templates
}

# The helper for one backend, from the sources above rather than a download.
_helper() {
  "$srcdir/$pkgbase/bin/build-helper" "$1" \
    -DFETCHCONTENT_SOURCE_DIR_SDCPP="$srcdir/stable-diffusion.cpp-$_sdcpp" \
    -DFETCHCONTENT_SOURCE_DIR_SDCPP_GGML="$srcdir/ggml-$_ggml" \
    -DFETCHCONTENT_SOURCE_DIR_SDCPP_CUTLASS="$srcdir/cutlass-$_cutlass"
}

build() {
  cd "$srcdir/$pkgbase"
  export FUGUE_SHARED_LIBS=OFF # the package is one self-contained binary; bin/build defaults to shared libraries for development
  ./bin/build fugue # the app only: the tests are built by check(), which a CI package build skips
  _helper vulkan
  [[ -n ${FUGUE_SKIP_CUDA:-} ]] || _helper cuda
}

check() {
  cd "$srcdir/$pkgbase"
  FUGUE_SHARED_LIBS=OFF ./bin/build
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure --no-tests=error
}

package_fugue() {
  cd "$srcdir/$pkgbase"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
  DESTDIR="$pkgdir" cmake --install build-helper-vulkan --prefix /usr --component fugue-helper
}

package_fugue-helper-cuda() {
  pkgdesc='Generation helper of Fugue for NVIDIA cards (CUDA)'
  depends=('fugue' 'cuda')
  cd "$srcdir/$pkgbase"
  DESTDIR="$pkgdir" cmake --install build-helper-cuda --prefix /usr --component fugue-helper
}
