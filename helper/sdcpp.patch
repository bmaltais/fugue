+    // Fugue's stage split (fugue_stages.h): conditioning and latents written after a stage of
+    // generate_image, or read in place of running it.
+    static bool fugue_fail(const fugue_stages::File& f, const char* what, const char* path) {
+        LOG_ERROR("fugue: %s '%s': %s", what, path, f.error.empty() ? "cannot write" : f.error.c_str());
+        return false;
+    }
+
+    static bool fugue_check_kind(fugue_stages::File& f, StableDiffusionGGML* sd, const char* kind) {
+        if (f.meta["kind"] != kind) {
+            return f.fail(std::string("not a ") + kind + " file");
+        }
+        if (f.meta["version"] != sd_version_name(sd->version)) {
+            return f.fail("made for " + f.meta["version"] + ", not " + sd_version_name(sd->version));
+        }
+        return true;
+    }
+
+    static bool fugue_save_cond(StableDiffusionGGML* sd, const ImageGenerationEmbeds& embeds, const char* path) {
+        fugue_stages::File f;
+        f.meta["kind"]    = "fugue/conditioning";
+        f.meta["version"] = sd_version_name(sd->version);
