+// Fugue spike (throwaway): save and load conditioning and latents at the stage seams of
+// generate_image, as safetensors-format files, driven by environment variables.
+//
+//   FUGUE_SAVE_COND=path     write the conditioning after the text-encode stage
+//   FUGUE_LOAD_COND=path     skip the text-encode stage and read conditioning from the file
+//   FUGUE_SAVE_LATENT=path   write the sampled latent(s)
+//   FUGUE_LOAD_LATENT=path   skip sampling and read the latent(s) from the file
+//   FUGUE_STOP_AFTER=cond|sample   return right after that stage (no image is produced)
+#ifndef __SD_PIPELINE_FUGUE_SPIKE_H__
+#define __SD_PIPELINE_FUGUE_SPIKE_H__
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "conditioning/conditioner.hpp"
+#include "core/tensor.hpp"
+#include "json.hpp"
+
+namespace fugue_spike {
+
+    inline const char* env(const char* name) {
+        const char* v = std::getenv(name);
+        return (v != nullptr && v[0] != '\0') ? v : nullptr;
+    }
+
+    inline bool stop_after(const char* stage) {
+        const char* v = env("FUGUE_STOP_AFTER");
+        return v != nullptr && std::strcmp(v, stage) == 0;
+    }
+
+    struct Blob {
+        std::string dtype;  // "F32" or "I32"
+        std::vector<int64_t> shape;
+        std::vector<uint8_t> bytes;
+    };
+    using Blobs = std::map<std::string, Blob>;
+
+    template <typename T>
+    inline void put(Blobs& blobs, const std::string& name, const sd::Tensor<T>& t, const char* dtype) {
+        if (t.empty()) {
+            return;
+        }
+        Blob b;
+        b.dtype = dtype;
+        b.shape = t.shape();
+        b.bytes.resize(static_cast<size_t>(t.numel()) * sizeof(T));
+        std::memcpy(b.bytes.data(), t.data(), b.bytes.size());
+        blobs[name] = std::move(b);
+    }
+    inline void put(Blobs& blobs, const std::string& name, const sd::Tensor<float>& t) {
+        put(blobs, name, t, "F32");
+    }
+    inline void put(Blobs& blobs, const std::string& name, const sd::Tensor<int32_t>& t) {
+        put(blobs, name, t, "I32");
+    }
+
+    template <typename T>
+    inline void get(const Blobs& blobs, const std::string& name, sd::Tensor<T>& out) {
+        auto it = blobs.find(name);
+        if (it == blobs.end()) {
+            return;
+        }
+        std::vector<T> data(it->second.bytes.size() / sizeof(T));
+        std::memcpy(data.data(), it->second.bytes.data(), it->second.bytes.size());
+        out = sd::Tensor<T>(it->second.shape, std::move(data));
+    }
+
+    inline bool write_file(const std::string& path, const Blobs& blobs, const nlohmann::json& meta) {
+        nlohmann::json header = nlohmann::json::object();
+        nlohmann::json md     = nlohmann::json::object();
+        for (auto it = meta.begin(); it != meta.end(); ++it) {
+            md[it.key()] = it.value().is_string() ? it.value().get<std::string>() : it.value().dump();
+        }
+        header["__metadata__"] = md;
+        uint64_t offset        = 0;
+        for (const auto& [name, b] : blobs) {
+            header[name] = {{"dtype", b.dtype}, {"shape", b.shape}, {"data_offsets", {offset, offset + b.bytes.size()}}};
+            offset += b.bytes.size();
+        }
+        std::string head = header.dump();
+        while (head.size() % 8 != 0) {
+            head.push_back(' ');
+        }
+        std::ofstream out(path, std::ios::binary | std::ios::trunc);
+        if (!out) {
+            return false;
+        }
+        uint64_t n = head.size();
+        out.write(reinterpret_cast<const char*>(&n), 8);
+        out.write(head.data(), static_cast<std::streamsize>(head.size()));
+        for (const auto& [name, b] : blobs) {
+            out.write(reinterpret_cast<const char*>(b.bytes.data()), static_cast<std::streamsize>(b.bytes.size()));
+        }
+        return static_cast<bool>(out);
+    }
+
+    inline bool read_file(const std::string& path, Blobs& blobs, nlohmann::json* meta = nullptr) {
+        std::ifstream in(path, std::ios::binary);
+        if (!in) {
+            return false;
+        }
+        uint64_t n = 0;
+        in.read(reinterpret_cast<char*>(&n), 8);
+        if (!in || n == 0 || n > (64u << 20)) {
+            return false;
+        }
+        std::string head(n, '\0');
+        in.read(head.data(), static_cast<std::streamsize>(n));
+        nlohmann::json header = nlohmann::json::parse(head, nullptr, false);
+        if (header.is_discarded()) {
+            return false;
+        }
+        std::streamoff base = 8 + static_cast<std::streamoff>(n);
+        for (auto it = header.begin(); it != header.end(); ++it) {
+            if (it.key() == "__metadata__") {
+                if (meta != nullptr) {
+                    *meta = it.value();
+                }
+                continue;
+            }
+            Blob b;
+            b.dtype      = it.value()["dtype"].get<std::string>();
+            b.shape      = it.value()["shape"].get<std::vector<int64_t>>();
+            uint64_t beg = it.value()["data_offsets"][0].get<uint64_t>();
+            uint64_t end = it.value()["data_offsets"][1].get<uint64_t>();
+            b.bytes.resize(end - beg);
+            in.seekg(base + static_cast<std::streamoff>(beg));
+            in.read(reinterpret_cast<char*>(b.bytes.data()), static_cast<std::streamsize>(b.bytes.size()));
+            if (!in) {
+                return false;
+            }
+            blobs[it.key()] = std::move(b);
+        }
+        return true;
+    }
+
+    // Fields not covered by the spike: c_ref_audios and c_reference_blocks (MiniMax H3 only).
+    inline bool cond_supported(const SDCondition& c) {
+        return c.c_ref_audios.empty() && c.c_reference_blocks.empty();
+    }
+
+    inline void put_cond(Blobs& blobs, const std::string& p, const SDCondition& c) {
+        put(blobs, p + ".c_crossattn", c.c_crossattn);
+        put(blobs, p + ".c_vector", c.c_vector);
+        put(blobs, p + ".c_concat", c.c_concat);
+        put(blobs, p + ".c_t5_ids", c.c_t5_ids);
+        put(blobs, p + ".c_t5_weights", c.c_t5_weights);
+        put(blobs, p + ".c_input_ids", c.c_input_ids);
+        put(blobs, p + ".c_position_ids", c.c_position_ids);
+        put(blobs, p + ".c_token_types", c.c_token_types);
+        put(blobs, p + ".c_vinput_mask", c.c_vinput_mask);
+        for (size_t i = 0; i < c.c_image_embeds.size(); i++) {
+            put(blobs, p + ".c_image_embeds." + std::to_string(i) + "." + std::to_string(c.c_image_embeds[i].first), c.c_image_embeds[i].second);
+        }
+        for (size_t i = 0; i < c.c_ref_images.size(); i++) {
+            put(blobs, p + ".c_ref_images." + std::to_string(i), c.c_ref_images[i]);
+        }
+        for (size_t i = 0; i < c.extra_c_crossattns.size(); i++) {
+            put(blobs, p + ".extra_c_crossattns." + std::to_string(i), c.extra_c_crossattns[i]);
+        }
+    }
+
+    inline void get_cond(const Blobs& blobs, const std::string& p, SDCondition& c) {
+        get(blobs, p + ".c_crossattn", c.c_crossattn);
+        get(blobs, p + ".c_vector", c.c_vector);
+        get(blobs, p + ".c_concat", c.c_concat);
+        get(blobs, p + ".c_t5_ids", c.c_t5_ids);
+        get(blobs, p + ".c_t5_weights", c.c_t5_weights);
+        get(blobs, p + ".c_input_ids", c.c_input_ids);
+        get(blobs, p + ".c_position_ids", c.c_position_ids);
+        get(blobs, p + ".c_token_types", c.c_token_types);
+        get(blobs, p + ".c_vinput_mask", c.c_vinput_mask);
+        for (size_t i = 0;; i++) {
+            const std::string prefix = p + ".c_image_embeds." + std::to_string(i) + ".";
+            auto it                  = blobs.lower_bound(prefix);
+            if (it == blobs.end() || it->first.compare(0, prefix.size(), prefix) != 0) {
+                break;
+            }
+            sd::Tensor<float> t;
+            get(blobs, it->first, t);
+            c.c_image_embeds.emplace_back(std::stoi(it->first.substr(prefix.size())), std::move(t));
+        }
+        for (size_t i = 0;; i++) {
+            const std::string name = p + ".c_ref_images." + std::to_string(i);
+            if (blobs.find(name) == blobs.end()) {
+                break;
+            }
+            sd::Tensor<float> t;
+            get(blobs, name, t);
+            c.c_ref_images.push_back(std::move(t));
+        }
+        for (size_t i = 0;; i++) {
+            const std::string name = p + ".extra_c_crossattns." + std::to_string(i);
+            if (blobs.find(name) == blobs.end()) {
+                break;
+            }
+            sd::Tensor<float> t;
+            get(blobs, name, t);
+            c.extra_c_crossattns.push_back(std::move(t));
+        }
+    }
+
+}  // namespace fugue_spike
+
+#endif  // __SD_PIPELINE_FUGUE_SPIKE_H__
