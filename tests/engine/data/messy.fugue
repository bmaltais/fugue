{"x-top": "kept", "run": {"seed": 7.0},
 "requires": {"packs": {"io.github.alice.tools": {"version": "1.2.0", "source": "https://github.com/alice/fugue-tools"}},
              "nodes": {"io.github.alice.tools/merge": "1.2.0", "fugue/text": "1.0.0",
                        "fugue/save-image": "1.0.0", "fugue/generate-image": "1.1.0"},
              "models": [{"source": "https://example.org/detail-tweaker", "resource": "fugue/lora",
                          "name": "detail-tweaker.safetensors",
                          "hash": "sha256:1111111111111111111111111111111111111111111111111111111111111111"}],
              "fugue": "0.1.0"},
 "layout": {"view": {"zoom": 1.50, "center": [4e2, 200]},
            "nodes": {"gen": {"title": "Fox", "size": [280, 0], "pos": [420, 160], "pinned": true,
                              "color": "accent", "collapsed": false}},
            "links": {"merge.images#1": {"points": [[700, 200]]}},
            "groups": {"local/two-pass": {"nodes": {"first": {"pos": [10, 20]}}, "links": {}, "frames": []}},
            "frames": [{"title": "Inputs", "rect": [0, 0, 380, 300], "nodes": ["prompt"], "id": "f1",
                        "color": "muted"}],
            "comments": [{"text": "Try 8 steps", "size": [240, 80], "pos": [0, 320], "id": "c1"}]},
 "groups": {"local/two-pass": {
   "x-group": 1, "version": "1.0.0",
   "outputs": [{"x-out": 1, "name": "image", "from": "second.image"}],
   "nodes": {"second": {"version": "1.1.0", "type": "fugue/generate-image",
                        "inputs": {"strength": 4e-1, "image": {"from": "first.image"}}},
             "first": {"version": "1.0.0", "type": "fugue/generate-image"}},
   "name": "Two-pass generate",
   "inputs": [{"targets": ["first.prompt", "second.prompt"], "name": "prompt"},
              {"targets": ["first.seed"], "name": "seed", "label": "Seed"},
              {"targets": ["second.quality"], "name": "quality", "default": "fast", "choices": ["fast", "fine"]},
              {"x-hint": "kept", "targets": ["second.steps"], "section": "Advanced", "name": "steps",
               "min": 1.0, "max": 12}],
   "description": "Generate, then refine.", "category": "Generate"}},
 "graph": {"x-graph": true, "provider": "omarchy-local",
   "nodes": {
     "two": {"version": "1.0.0", "type": "local/two-pass", "mode": "mute",
             "inputs": {"seed": 42, "prompt": {"from": "prompt.text"}}},
     "save": {"version": "1.0.0", "type": "fugue/save-image",
              "inputs": {"overwrite": false, "name": "fox", "image": {"from": "merge.image"}},
              "frozen": "sha256:3333333333333333333333333333333333333333333333333333333333333333"},
     "prompt": {"version": "1.0.0", "type": "fugue/text", "inputs": {"text": "a red fox in fresh snow"}},
     "merge": {"x-note": "kept", "version": "1.2.0", "type": "io.github.alice.tools/merge", "mode": "bypass",
               "inputs": {"images": [{"from": "gen.image"}, {"from": "two.image"}]}},
     "gen": {"version": "1.0.0", "type": "fugue/generate-image", "provider": "omarchy-local",
             "inputs": {"width": 1024, "strength": 0.4, "seed": {"auto": "random"},
                        "prompt": {"from": "prompt.text"},
                        "lora": {"resource": "fugue/lora", "name": "detail-tweaker.safetensors",
                                 "hash": "sha256:1111111111111111111111111111111111111111111111111111111111111111"},
                        "height": 1024.0}}}},
 "fugue": 1}
