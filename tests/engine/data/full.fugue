        "version": "1.0.0"
      },
      "two": {
        "inputs": {
          "prompt": {
            "from": "prompt.text"
          },
          "seed": 42
        },
        "mode": "mute",
        "type": "local/two-pass",
        "version": "1.0.0"
      }
    },
    "provider": "omarchy-local",
    "x-graph": true
