<?xml version="1.0" encoding="UTF-8"?>
<!-- Fugue's file types (spec 11.1, 11.5): installed to share/mime/packages, where the desktop
     learns them, so a file manager opens them with Fugue (share/fugue.desktop MimeType). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-fugue-workflow">
    <comment>Fugue workflow</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.fugue"/>
  </mime-type>
  <mime-type type="application/x-fugue-package">
    <comment>Fugue package</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.fuguepack"/>
  </mime-type>
  <!-- An app bundle (#394): the same zip as a package, read by the same reader, but opened as an app in a window of its own
       (share/fugue-app.desktop runs fugue with its app option). -->
  <mime-type type="application/x-fugue-app">
    <comment>Fugue app</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.fugueapp"/>
  </mime-type>
</mime-info>
