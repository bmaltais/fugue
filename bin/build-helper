#!/bin/bash
# Builds fugue-helper (helper/CMakeLists.txt) for one backend into build-helper-<backend>/:
#
#   bin/build-helper cuda|vulkan|cpu [cmake options]
#
# CUDA builds for this machine's GPUs by default (their compute capabilities from nvidia-smi, and
# GGML_NATIVE=ON): one architecture instead of the portable list compiles about five times less, and every
# worktree gets the same flags, so ccache reuses the objects of another worktree's helper build (a portable
# build in one worktree and a local one in another share nothing). FUGUE_HELPER_PORTABLE=1, or an explicit
# -DCMAKE_CUDA_ARCHITECTURES=..., keeps the portable settings: the package (packaging/PKGBUILD) and
# bin/package-helper use them. Without nvidia-smi or a GPU the portable default stays.
#
# FUGUE_HELPER_BUILD_DIR=<folder> builds there instead of build-helper-<backend>/ (bin/package-helper uses its own, so a
# portable build never overwrites the native one).
#
# FUGUE_SDCPP_SOURCE=<a clone of github.com/bmaltais/stable-diffusion.cpp> builds that folder instead of the
# pinned tarball, so an engine edit rebuilds only what it touches (helper/README.md, Changing the engine).
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
backend="${1:-cpu}"
(($#)) && shift
if [[ ! $backend =~ ^(cuda|vulkan|cpu)$ ]]; then
  echo "usage: bin/build-helper cuda|vulkan|cpu [cmake options]" >&2
  exit 2
fi
build_dir="${FUGUE_HELPER_BUILD_DIR:-$root/build-helper-$backend}"
args=()
if [[ -n ${FUGUE_SDCPP_SOURCE:-} ]]; then
  if [[ ! -f $FUGUE_SDCPP_SOURCE/CMakeLists.txt ]]; then
    echo "FUGUE_SDCPP_SOURCE=$FUGUE_SDCPP_SOURCE is not a stable-diffusion.cpp checkout" >&2
    exit 2
  fi
  args+=(-DFETCHCONTENT_SOURCE_DIR_SDCPP="$(cd "$FUGUE_SDCPP_SOURCE" && pwd)")
else
  # CMake keeps the path in the build folder's cache: without this a build after a clone's would still use the clone.
  args+=(-UFETCHCONTENT_SOURCE_DIR_SDCPP)
fi
if command -v ccache >/dev/null; then
  # As bin/build: objects are reused across build folders and worktrees, so a fresh
  # build-helper-<backend>/ or a changed engine commit recompiles only the files that changed.
  export CCACHE_BASEDIR="${CCACHE_BASEDIR:-$(dirname "$root")}"
  args+=(-DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DCMAKE_CUDA_COMPILER_LAUNCHER=ccache)
else
  args+=(-DCMAKE_C_COMPILER_LAUNCHER= -DCMAKE_CXX_COMPILER_LAUNCHER= -DCMAKE_CUDA_COMPILER_LAUNCHER=)
fi
if [[ $backend == cuda ]]; then
  # Arch's nvcc asks for an older GCC than the system one; clang++ works (docs/spikes/02). An
  # NVCC_CCBIN naming a compiler that is not installed (a GCC since removed) is passed over.
  # Without clang++ (a DGX Spark's Ubuntu) the system g++ is the one the toolkit supports.
  if [[ ! -x ${NVCC_CCBIN:-} ]]; then
    if [[ -x /usr/bin/clang++ ]]; then export NVCC_CCBIN=/usr/bin/clang++; else export NVCC_CCBIN=/usr/bin/g++; fi
  fi
  export PATH="/opt/cuda/bin:/usr/local/cuda/bin:$PATH"
  args+=(-DCMAKE_CUDA_HOST_COMPILER="$NVCC_CCBIN")
  # This machine's GPUs unless portable is asked for (see the top). "86", not "native": CMake passes
  # `-arch=native` for that, which hashes differently from the same architecture named.
  if [[ ${FUGUE_HELPER_PORTABLE:-} != 1 && " $* " != *" -DCMAKE_CUDA_ARCHITECTURES="* ]]; then
    caps=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | tr -d ' .' | grep -E '^[0-9]+$' | sort -un | paste -sd';' || true)
    if [[ -n $caps ]]; then
      args+=(-DCMAKE_CUDA_ARCHITECTURES="$caps" -DGGML_NATIVE=ON)
      echo "bin/build-helper: CUDA for this machine's GPU (sm $caps); FUGUE_HELPER_PORTABLE=1 for the package's portable build" >&2
    fi
  fi
fi
# Quiet unless it fails.
if ! out=$(cmake -S "$root/helper" -B "$build_dir" -DFUGUE_HELPER_BACKEND="$backend" "${args[@]}" "$@" 2>&1); then
  echo "$out" >&2
  exit 1
fi
# CMAKE_BUILD_PARALLEL_LEVEL caps the compiles (a quieter machine); unset, one per core.
cmake --build "$build_dir" -j"${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc)}"
