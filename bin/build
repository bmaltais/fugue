#!/bin/bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
# One big build at a time on this machine, across all worktrees and agents: each build runs one
# compile per core, so several at once only oversubscribe the CPU (a load of 20 on 12 cores, each
# build slower than if they had queued). A second build waits here. bin/test holds the same lock
# for its whole run and says so in FUGUE_BUILD_LOCKED, so it does not wait on itself.
if [[ -z ${FUGUE_BUILD_LOCKED:-} ]]; then
  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/fugue-test.lock"
  if ! flock -n 9; then
    echo "bin/build: another build or test run is in progress, waiting for it..." >&2
    flock 9
  fi
fi
launcher=()
if command -v ccache >/dev/null; then
  # Reuse compiled objects, also across git worktrees. Every worktree has its own
  # absolute paths, so base_dir (the parent of all worktrees) makes ccache hash
  # paths relative to it. Without ccache the build is unchanged.
  export CCACHE_BASEDIR="${CCACHE_BASEDIR:-$(dirname "$root")}"
  launcher=(-DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache)
else
  # Clear a launcher an earlier configure cached, or a build/ made while ccache was
  # installed fails once it is gone.
  launcher=(-DCMAKE_C_COMPILER_LAUNCHER= -DCMAKE_CXX_COMPILER_LAUNCHER=)
fi
# A new build folder uses Ninja when it is installed (it schedules the ~190 links and the compiles better than
# Make, and starts up faster); a folder an earlier run made with Make keeps it, because CMake cannot switch
# generator in place: delete build/ to move to Ninja. Without ninja nothing changes.
generator=()
if [[ ! -f $root/build/CMakeCache.txt ]] && command -v ninja >/dev/null; then
  generator=(-G Ninja)
fi
cmake -S "$root" -B "$root/build" "${generator[@]}" -DCMAKE_BUILD_TYPE=Release "${launcher[@]}" >/dev/null
# Optional CMake targets: `bin/build fugue` builds only the app (no tests). None builds all.
targets=()
if (($#)); then
  targets=(--target "$@")
fi
cmake --build "$root/build" -j"$(nproc)" "${targets[@]}"
