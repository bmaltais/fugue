#!/bin/bash
set -euo pipefail

# Arguments go to ctest, so `bin/test -V` shows every Qt test function as it runs. The tests run in
# parallel, one per core (each has its own HOME and XDG folders), or CTEST_PARALLEL_LEVEL at a time;
# `bin/test -j1` runs them in turn, the last -j wins. The build before it follows CMAKE_BUILD_PARALLEL_LEVEL
# (bin/build). `bin/test --changed [base]` builds and runs only the tests the change since base
# (default origin/main) can affect, chosen by bin/test-select, and says which; a shared file (build files,
# resources, core headers) makes it the whole suite. `bin/test test_a test_b [ctest args]` (also fugue_tests) builds and runs
# only those tests (and their shards). Plain `bin/test` is always the whole suite. With --changed, qmllint
# (4 chunks, qmllint.1of4 ...) lints only the changed .qml files (FUGUE_QMLLINT_FILES, tests/qmllint.cmake).
root="$(cd "$(dirname "$0")/.." && pwd)"
changed=0
base=origin/main
named=()
while [[ ${1:-} == test_* || ${1:-} == qmllint || ${1:-} == fugue_tests ]]; do
  named+=("$1")
  shift
done
if ((${#named[@]})) && [[ ${1:-} == --changed ]]; then
  echo "bin/test: give test names or --changed, not both" >&2
  exit 2
fi
if [[ ${1:-} == --changed ]]; then
  changed=1
  shift
  if [[ -n ${1:-} && $1 != -* ]]; then
    base=$1
    shift
  fi
fi
# One full build-and-test run at a time on this machine, across all worktrees and agents: several at
# once only slow each other down. A second run waits here for the first.
lock="${XDG_RUNTIME_DIR:-/tmp}/fugue-test.lock"
exec 9>"$lock"
if ! flock -n 9; then
  echo "bin/test: another run is in progress, waiting for it..." >&2
  flock 9
fi
export FUGUE_BUILD_LOCKED=1 # this run holds the lock: bin/build must not wait for it
selected=()
narrow=0
if ((changed)); then
  read -r -a pick < <("$root/bin/test-select" "$base")
  case ${pick[0]} in
    none) echo "bin/test --changed: no test to run (${pick[*]:1})"; exit 0 ;;
    full) echo "bin/test --changed: the whole suite (${pick[*]:1})" ;;
    tests)
      narrow=1
      # qmllint lints only the .qml files that changed here; the whole suite lints them all.
      if [[ " ${pick[*]:1} " == *" qmllint "* ]]; then
        qml_files=""
        while IFS= read -r file; do
          [[ -f $root/$file ]] && qml_files+="${qml_files:+;}$root/$file"
        done < <(cd "$root" && { git diff --name-only "$(git merge-base "$base" HEAD)"; git ls-files -o --exclude-standard; } | grep '^src/.*\.qml$' | sort -u || true)
        export FUGUE_QMLLINT_FILES=${qml_files:-none}
      fi
      for name in "${pick[@]:1}"; do [[ $name == qmllint ]] || selected+=("$name"); done
      echo "bin/test --changed: ${#pick[@]} tests: ${pick[*]:1}" ;;
  esac
fi
if ((${#named[@]})); then
  narrow=1
  pick=(tests "${named[@]}")
  for name in "${named[@]}"; do [[ $name == qmllint ]] || selected+=("$name"); done
fi
if ((narrow)); then
  "$root/bin/build" "${selected[@]:-fugue}" # qmllint alone needs only the app's QML module
  # A test may be sharded (name.1of4); qmllint is the one test that is no program.
  regex="^($(IFS='|'; echo "${pick[*]:1}"))(\\.[0-9]+of[0-9]+)?$"
  set -- -R "$regex" "$@"
else
  "$root/bin/build"
fi
QT_QPA_PLATFORM=offscreen ctest --test-dir "$root/build" --output-on-failure --no-tests=error -j"${CTEST_PARALLEL_LEVEL:-$(nproc)}" "$@"
